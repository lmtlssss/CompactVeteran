{
  "description": "Keep Sol context in Git and restart from a durable project map.",
  "hooks": {
    "UserPromptSubmit": [{"hooks":[{"type":"command","command":"${PLUGIN_DATA}/compactveteran hook prompt","timeout":10}]}],
    "Stop": [{"hooks":[{"type":"command","command":"${PLUGIN_DATA}/compactveteran hook stop","timeout":120}]}],
    "PreCompact": [{"matcher":"auto|manual","hooks":[{"type":"command","command":"${PLUGIN_DATA}/compactveteran hook precompact","timeout":120}]}],
    "SessionStart": [{"matcher":"startup|resume","hooks":[{"type":"command","command":"${PLUGIN_DATA}/compactveteran hook session-start","timeout":120}]}]
  }
}
